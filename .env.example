# FAMGATEWAY_API_KEY: FamGateway merchant API key for real automated UPI payment gateway.
# Get this from https://famgateway.in/dashboard
FAMGATEWAY_API_KEY="YOUR_FAMGATEWAY_API_KEY"

# JWT_SECRET: Strong secret key for signing server-side JWT authentication tokens.
JWT_SECRET="AKAZA_SECRET_KEY_CHANGE_IN_PRODUCTION"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# SUPPORT_WHATSAPP_NUMBER: Optional support WhatsApp international phone number without the plus sign (e.g. 919876543210).
# Leave empty or omit if not configured.
SUPPORT_WHATSAPP_NUMBER=""

# SUPPORT_EMAIL: Optional support contact email address (e.g. support@akashstore.com).
# Leave empty or omit if not configured.
SUPPORT_EMAIL=""
